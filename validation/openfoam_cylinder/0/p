/*--------------------------------*- C++ -*----------------------------------*\
  Flow past a cylinder at Re = 100, same domain as the LBM cylinder case.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    cylinder
    {
        type            zeroGradient;
    }
    "(top|bottom)"
    {
        type            cyclic;
    }
    frontAndBack
    {
        type            empty;
    }
}
